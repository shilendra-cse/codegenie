{
  "name": "@hobai/github",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub App access shared by the server and the worker: repo-scoped installation tokens, API clients, the bot identity, webhook signatures",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.16",
    "@octokit/request-error": "^7.1.2",
    "@octokit/rest": "^22.0.1"
  }
}
