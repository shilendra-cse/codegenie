    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.16",
    "@octokit/request-error": "^7.1.2",
    "@octokit/rest": "^22.0.1"
  }
