{
  "name": "@hobai/sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Sandbox interface and providers (Daytona, Docker)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build-image": "docker build -t hobai-base -f images/base/Dockerfile images/base",
    "build-snapshot": "node --env-file-if-exists=../../apps/worker/.env --import tsx src/scripts/build-snapshot.ts",
    "clean": "ids=$(docker ps -aq --filter label=hobai=1); [ -z \"$ids\" ] || docker rm -f $ids"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.225.0",
    "@hobai/shared": "workspace:*"
  }
}
