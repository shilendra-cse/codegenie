{
  "name": "@codegenie/sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Sandbox interface and providers (Daytona, Docker)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build-image": "docker build -t codegenie-base -f images/base/Dockerfile images/base",
    "clean": "ids=$(docker ps -aq --filter label=codegenie=1); [ -z \"$ids\" ] || docker rm -f $ids"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3",
    "@types/node": "^24.5.2"
  }
}
