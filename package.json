{
  "name": "hobai",
  "version": "1.0.0",
  "private": true,
  "description": "Web-based autonomous coding agent: assign a task, get a pull request.",
  "scripts": {
    "setup": "bash script/setup.sh",
    "migrate": "bash script/migrate.sh",
    "db:generate": "pnpm --filter @hobai/db generate",
    "db:push": "pnpm --filter @hobai/db push",
    "db:studio": "pnpm --filter @hobai/db studio",
    "agent:run": "pnpm --filter @hobai/cli start",
    "agent:setup": "pnpm --filter @hobai/cli run setup",
    "eval": "pnpm --filter @hobai/evals start",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "dev:worker": "pnpm --filter @hobai/worker dev",
    "dev:webhooks": "pnpm --filter server webhooks",
    "admin:set-plan": "pnpm --filter server admin:set-plan",
    "build:web": "pnpm --filter web build",
    "build:server": "pnpm --filter server build",
    "build:worker": "pnpm --filter @hobai/worker build",
    "sandbox:build-image": "pnpm --filter @hobai/sandbox build-image",
    "sandbox:build-snapshot": "pnpm --filter @hobai/sandbox build-snapshot",
    "sandbox:clean": "pnpm --filter @hobai/sandbox clean",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r --if-present run type-check",
    "typecheck:shared": "pnpm --filter @hobai/shared type-check",
    "format:check": "pnpm -r --if-present run format:check",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present run test",
    "e2e": "pnpm --filter @hobai/e2e e2e",
    "e2e:report": "pnpm --filter @hobai/e2e exec playwright show-report"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.18.1",
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
