{
  "name": "codegenie",
  "version": "1.0.0",
  "private": true,
  "description": "Web-based autonomous coding agent: assign a task, get a pull request.",
  "scripts": {
    "setup": "bash script/setup.sh",
    "migrate": "bash script/migrate.sh",
    "db:generate": "pnpm --filter @codegenie/db generate",
    "db:push": "pnpm --filter @codegenie/db push",
    "db:studio": "pnpm --filter @codegenie/db studio",
    "agent:run": "pnpm --filter @codegenie/cli start",
    "agent:setup": "pnpm --filter @codegenie/cli run setup",
    "eval": "pnpm --filter @codegenie/evals start",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "dev:worker": "pnpm --filter @codegenie/worker dev",
    "dev:webhooks": "pnpm --filter server webhooks",
    "build:web": "pnpm --filter web build",
    "build:server": "pnpm --filter server build",
    "build:worker": "pnpm --filter @codegenie/worker build",
    "sandbox:build-image": "pnpm --filter @codegenie/sandbox build-image",
    "sandbox:build-snapshot": "pnpm --filter @codegenie/sandbox build-snapshot",
    "sandbox:clean": "pnpm --filter @codegenie/sandbox clean",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r --if-present run type-check",
    "typecheck:shared": "pnpm --filter @codegenie/shared type-check",
    "format:check": "pnpm -r --if-present run format:check",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present run test",
    "e2e": "pnpm --filter @codegenie/e2e e2e",
    "e2e:report": "pnpm --filter @codegenie/e2e exec playwright show-report"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.18.1",
  "devDependencies": {
    "vitest": "^5.0.4"
  }
}
