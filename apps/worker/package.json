{
  "name": "@hobai/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker: consumes queued task runs and project onboarding, and runs them in a sandbox",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/start-worker.ts",
      "default": "./src/start-worker.ts"
    },
    "./testing": {
      "types": "./src/testing/fake-github-app.ts",
      "default": "./src/testing/fake-github-app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@hobai/agent": "workspace:*",
    "@hobai/db": "workspace:*",
    "@hobai/github": "workspace:*",
    "@hobai/runner": "workspace:*",
    "@hobai/sandbox": "workspace:*",
    "@hobai/shared": "workspace:*",
    "bullmq": "^6.5.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
