{
  "name": "@hobai/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker: consumes queued task runs and project onboarding, and runs them in a sandbox",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/start-worker.ts",
      "default": "./src/start-worker.ts"
    },
    "./testing": {
      "types": "./src/testing/fake-github-app.ts",
      "default": "./src/testing/fake-github-app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tsup": "^9.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "@hobai/agent": "workspace:*",
    "@hobai/db": "workspace:*",
    "@hobai/github": "workspace:*",
    "@hobai/runner": "workspace:*",
    "@hobai/sandbox": "workspace:*",
    "@hobai/shared": "workspace:*",
    "bullmq": "^6.3.17",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^5.10.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
