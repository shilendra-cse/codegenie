OPENAI_API_KEY=your-openai-api-key
AGENT_MODEL=openai:gpt-6-luna
WORKER_CONCURRENCY=3

# docker (local containers) or daytona (cloud sandboxes)
SANDBOX_PROVIDER=docker
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# Postgres and Redis from apps/server/docker-compose.yml
DATABASE_URL=postgresql://codegenie_user:codegenie_password@localhost:5439/codegenie_db
REDIS_URL=redis://localhost:6380

LOG_LEVEL=info
