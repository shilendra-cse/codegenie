OPENAI_API_KEY=your-openai-api-key
AGENT_MODEL=openai:gpt-6-luna
WORKER_CONCURRENCY=3

# docker (local containers) or daytona (cloud sandboxes)
SANDBOX_PROVIDER=docker
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# How long a lost run's stopped Daytona sandbox is kept for resuming (hours)
SANDBOX_RETENTION_HOURS=4
REAPER_INTERVAL_MINUTES=5
# How long setup waits for an answer to its question before it stops.
ONBOARDING_ANSWER_TIMEOUT_MINUTES=30

# GitHub App: every run clones with a token from it (docs/knowledge/github.md)
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...the .pem file's contents...
-----END RSA PRIVATE KEY-----"

# Postgres and Redis from apps/server/docker-compose.yml
DATABASE_URL=postgresql://codegenie_user:codegenie_password@localhost:5439/codegenie_db
REDIS_URL=redis://localhost:6380

LOG_LEVEL=info
