{
  "name": "@hobai/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Run a hobai task from the terminal",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "setup": "tsx src/main.ts setup"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@hobai/agent": "workspace:*",
    "@hobai/runner": "workspace:*",
    "@hobai/shared": "workspace:*",
    "@hobai/terminal": "workspace:*",
    "dotenv": "^17.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3",
    "tsx": "^4.20.5"
  }
}
