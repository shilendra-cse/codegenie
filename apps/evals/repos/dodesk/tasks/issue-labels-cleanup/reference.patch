+function cleanLabels(labels: string[]) {
+  const seen = new Set<string>();
+  const cleaned: string[] = [];
+  for (const raw of labels) {
+    const label = raw.trim();
+    if (!label || seen.has(label.toLowerCase())) continue;
+    seen.add(label.toLowerCase());
+    cleaned.push(label);
+  }
+  return cleaned;
+}
