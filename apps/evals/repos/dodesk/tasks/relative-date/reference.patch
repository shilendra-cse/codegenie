 export function cn(...inputs: ClassValue[]) {
   return twMerge(clsx(inputs))
 }
+
+const MINUTE = 60_000
+const HOUR = 60 * MINUTE
+const DAY = 24 * HOUR
+
+export function formatRelativeDate(date: Date | string, now: Date = new Date()): string {
+  const then = typeof date === "string" ? new Date(date) : date
+  const diff = now.getTime() - then.getTime()
+  const count = (unit: number, name: string) => {
+    const n = Math.floor(diff / unit)
+    return `${n} ${name}${n === 1 ? "" : "s"} ago`
+  }
+
+  if (diff < MINUTE) return "just now"
+  if (diff < HOUR) return count(MINUTE, "minute")
+  if (diff < DAY) return count(HOUR, "hour")
+  if (diff < 2 * DAY) return "yesterday"
+  if (diff < 7 * DAY) return count(DAY, "day")
+
+  const sameYear = then.getFullYear() === now.getFullYear()
+  return then.toLocaleDateString("en-US", {
+    month: "short",
+    day: "numeric",
+    ...(sameYear ? {} : { year: "numeric" }),
+  })
+}
