{
  "name": "@hobai/server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "pnpm docker:up && tsx watch src/index.ts",
    "dev:only": "tsx watch src/index.ts",
    "webhooks": "node --env-file-if-exists=.env --import tsx src/dev/forward-webhooks.ts",
    "admin:set-plan": "node --env-file-if-exists=.env --import tsx src/scripts/set-plan.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "migrate": "node --enable-source-maps dist/migrate.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "smee-client": "^5.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@hobai/db": "workspace:*",
    "@hobai/github": "workspace:*",
    "@hobai/shared": "workspace:*",
    "@types/swagger-ui-express": "^4.1.8",
    "better-auth": "~1.6.33",
    "bullmq": "^6.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  }
}
