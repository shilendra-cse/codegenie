# Environment Configuration
NODE_ENV=development
PORT=3001
HOST=localhost
LOG_LEVEL=debug

# Database Configuration
DB_HOST=localhost
DB_PORT=5439
DB_NAME=codegenie_db
DB_USER=codegenie_user
DB_PASSWORD=codegenie_password
DATABASE_URL=postgresql://codegenie_user:codegenie_password@localhost:5439/codegenie_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=codegenie_password
REDIS_URL=redis://localhost:6380

# Frontend URL
FRONTEND_URL=http://localhost:3000

# GitHub App (docs/knowledge/github.md): sign-in uses its Client ID and a client secret from its settings page
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...the .pem file's contents...
-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# Development: the smee.io channel set as the App's webhook URL, forwarded by pnpm dev:webhooks
GITHUB_WEBHOOK_PROXY_URL=https://smee.io/your-channel

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=your-better-auth-secret